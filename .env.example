# ===== Скопируйте этот файл в .env и заполните =====

# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# API-ключ с z.ai (меню профиля -> API Keys -> Create API Key)
ZAI_API_KEY=

# Telegram ID тех, кому разрешён доступ (через запятую).
# Свой ID можно узнать у бота @userinfobot.
# Пример: ALLOWED_USER_IDS=123456789,987654321
# ВНИМАНИЕ: если оставить пустым, бот будет отвечать любому!
ALLOWED_USER_IDS=

# Модель по умолчанию (бесплатная)
DEFAULT_MODEL=glm-4.7-flash

# Системный промпт (характер ассистента) — можно поменять под себя
SYSTEM_PROMPT=Ты — дружелюбный и полезный ассистент в личном Telegram-боте. Отвечай на языке собеседника, по делу и без лишней воды, если не попросили иначе.

# Сколько последних сообщений отправлять модели как контекст
CONTEXT_MESSAGES=20

# Сколько сообщений хранить в базе на пользователя
MAX_HISTORY_ROWS=200

# Максимальный размер фото в МБ
MAX_PHOTO_MB=10
